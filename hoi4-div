#!/usr/bin/env bash
# ==============================================================================
# hoi4-div — Official HOI4 v1.19.4.2 Division Optimizer & Simulator CLI Wrapper
# ==============================================================================
# Executes `cli.py` through the project virtual environment (`.venv` or `venv`),
# automatically provisioning `.venv` on first run if not already present.
# All arguments are forwarded directly to `cli.py`.
#
# Examples:
#   ./hoi4-div optimize --method cso --year 1945 --doctrine superior_firepower --tank-mode nsb_auto_optimize --objective best_overall
#   ./hoi4-div compare --methods cso,ga,pso,de,sa --year 1945 --doctrine mass_assault --tank-mode nsb_auto_optimize
#   ./hoi4-div units --list-doctrines
#   ./hoi4-div units --year 1945 --design-tank --tank-mode nsb_meta_soft_attack
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
    VENV_PYTHON="${SCRIPT_DIR}/.venv/bin/python"
elif [[ -x "${SCRIPT_DIR}/venv/bin/python" ]]; then
    VENV_PYTHON="${SCRIPT_DIR}/venv/bin/python"
else
    echo "[hoi4-div] Initializing Python virtual environment at ${SCRIPT_DIR}/.venv ..." >&2
    python3 -m venv "${SCRIPT_DIR}/.venv"
    VENV_PYTHON="${SCRIPT_DIR}/.venv/bin/python"
fi

exec "${VENV_PYTHON}" "${SCRIPT_DIR}/cli.py" "$@"
